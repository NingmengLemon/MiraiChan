# systemd unit 模板。复制为 /etc/systemd/system/<name>.service 后按实际情况替换尖括号里的值。
#
# 用 `mb run` 以子进程方式运行, `.重启` 指令 (mbplugin_rebootable) 依赖这种方式;
# `.关机` 会让进程正常退出, 所以 Restart 用 on-failure 而不是 always。

[Unit]
Description=MiraiChan QQ bot (melobot)
After=network-online.target
Wants=network-online.target
# 若 OneBot 实现端也由 systemd 管理, 可以加上:
# After=<onebot-impl>.service

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=<user>
WorkingDirectory=<deploy-dir>
Environment=HOME=<home-of-user>
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=<path-to-uv> run --frozen --no-sync mb run miracle_entrance.py
# systemd 默认的 control-group 会让 uv 和 mb 各收到一次 SIGTERM, uv 又会把它转发给 mb,
# 于是 mb 的信号处理器可能重入并偶发 FileNotFoundError 退出 1。mixed 只给主进程发 SIGTERM,
# 由 uv 转发一次给 mb; mb 的子进程靠 alive 文件退出。上游修复后可以去掉这一行。
KillMode=mixed
Restart=on-failure
RestartSec=10
# 不写 core dump: 实现端或依赖崩溃时动辄几个 GB
LimitCORE=0
# 日志交给 journald; 需要文件时改成 append:<log-file>
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
